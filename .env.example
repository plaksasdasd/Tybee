# Telegram bot token from @BotFather
BOT_TOKEN=123456:CHANGEME

# Comma-separated Telegram user IDs that act as administrators
ADMIN_IDS=

# Optional: group/channel chat id used as the support desk where user dialogs
# are relayed. If empty, messages are relayed to the first admin from ADMIN_IDS.
SUPPORT_CHAT_ID=

# PostgreSQL connection (defaults match docker-compose service)
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=taibi
POSTGRES_USER=taibi
POSTGRES_PASSWORD=taibi
