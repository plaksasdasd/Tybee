# Shared environment for the Tybee and support bots running in one container
TYBEE_BOT_TOKEN=
TYBEE_ADMIN_IDS=

SUPPORT_BOT_TOKEN=
SUPPORT_ADMIN_IDS=
SUPPORT_STAFF_IDS=

# Main database (orders, users, support_inbox/support_outbox)
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=taibi
POSTGRES_USER=taibi
POSTGRES_PASSWORD=taibi

# Separate support database on the same PostgreSQL server
SUPPORT_POSTGRES_HOST=db
SUPPORT_POSTGRES_PORT=5432
SUPPORT_POSTGRES_DB=tybee_support
SUPPORT_POSTGRES_USER=taibi
SUPPORT_POSTGRES_PASSWORD=taibi

PAYMENT_REQUISITES=
UNBAN_FINE_STARS=50

# Robokassa for support-created /order invoices
ROBOKASSA_SHOP_ID=
ROBOKASSA_PASSWORD1=
ROBOKASSA_PASSWORD2=
ROBOKASSA_HASH_ALGORITHM=MD5
ROBOKASSA_TEST=true

# Optional Avito integration
AVITO_ENABLED=false
AVITO_CLIENT_ID=
AVITO_CLIENT_SECRET=
AVITO_WEBHOOK_URL=
AVITO_WEBHOOK_SECRET=
AVITO_WEBHOOK_PORT=8080
