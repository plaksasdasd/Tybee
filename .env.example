# Telegram bot token from @BotFather
BOT_TOKEN=123456:CHANGEME

# Comma-separated Telegram user IDs that act as administrators
ADMIN_IDS=

# Optional: group/channel chat id used as the support desk where user dialogs
# are relayed. If empty, messages are relayed to the first admin from ADMIN_IDS.
# For per-client threads, use a forum (topics enabled) supergroup id.
SUPPORT_CHAT_ID=

# Optional: payment requisites shown to the client on every invoice. If empty,
# a placeholder is used.
PAYMENT_REQUISITES=

# Fine (in Telegram Stars / XTR) a banned user must pay to get unblocked.
UNBAN_FINE_STARS=50

# PostgreSQL connection (defaults match docker-compose service)
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=taibi
POSTGRES_USER=taibi
POSTGRES_PASSWORD=taibi
