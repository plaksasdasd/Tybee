# Shared environment for the Tybee and support bots running in one container
TYBEE_BOT_TOKEN=123456:CHANGEME
TYBEE_ADMIN_IDS=

SUPPORT_BOT_TOKEN=123456:CHANGEME
SUPPORT_ADMIN_IDS=
SUPPORT_STAFF_IDS=

# Main database (orders, users, support_inbox/support_outbox)
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=taibi
POSTGRES_USER=taibi
POSTGRES_PASSWORD=taibi

# Separate support database on the same PostgreSQL server
SUPPORT_POSTGRES_HOST=db
SUPPORT_POSTGRES_PORT=5432
SUPPORT_POSTGRES_DB=tybee_support
SUPPORT_POSTGRES_USER=taibi
SUPPORT_POSTGRES_PASSWORD=taibi

# Main database used by the support bot (usually the same values as POSTGRES_*)
SOURCE_POSTGRES_HOST=db
SOURCE_POSTGRES_PORT=5432
SOURCE_POSTGRES_DB=taibi
SOURCE_POSTGRES_USER=taibi
SOURCE_POSTGRES_PASSWORD=taibi

PAYMENT_REQUISITES=
UNBAN_FINE_STARS=50

# Optional Avito integration
AVITO_ENABLED=false
AVITO_CLIENT_ID=
AVITO_CLIENT_SECRET=
AVITO_WEBHOOK_URL=
AVITO_WEBHOOK_SECRET=
AVITO_WEBHOOK_PORT=8080

