# Telegram bot token from @BotFather
BOT_TOKEN=123456:CHANGEME

# Comma-separated Telegram user IDs that act as administrators
ADMIN_IDS=

# Optional: group/channel chat id used as the support desk where user dialogs
# are relayed. If empty, messages are relayed to the first admin from ADMIN_IDS.
# For per-client threads, use a forum (topics enabled) supergroup id.
SUPPORT_CHAT_ID=

# Optional: payment requisites shown to the client on every invoice. If empty,
# a placeholder is used.
PAYMENT_REQUISITES=

# Fine (in Telegram Stars / XTR) a banned user must pay to get unblocked.
UNBAN_FINE_STARS=50

# Avito Messenger API integration (https://www.avito.ru/developers).
# Master switch: the integration starts only when AVITO_ENABLED=true AND the
# credentials below are filled in. Leave false to run without Avito.
AVITO_ENABLED=false

# Create an app at https://dev.avito.ru and put its credentials here.
AVITO_CLIENT_ID=
AVITO_CLIENT_SECRET=

# Public HTTPS base URL Avito can reach (e.g. https://bot.example.com or a
# ngrok tunnel). Webhook endpoint: {URL}/avito/webhook/{AVITO_WEBHOOK_SECRET}.
AVITO_WEBHOOK_URL=
# Required random secret path segment protecting the webhook endpoint.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
AVITO_WEBHOOK_SECRET=
# Local port the webhook HTTP server listens on.
AVITO_WEBHOOK_PORT=8080

# PostgreSQL connection (defaults match docker-compose service)
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=taibi
POSTGRES_USER=taibi
POSTGRES_PASSWORD=taibi
