# Environment shared by both processes: "bot" (cover bots, outbox/broadcast workers,
# Avito + Robokassa webhook server) and "site" (web panel). Copy to .env and fill in.

# ---------------------------------------------------------------- PostgreSQL
# One database for everything (clients, orders, covers, staff, support, money).
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=taibi
POSTGRES_USER=taibi
# Required by docker-compose.
POSTGRES_PASSWORD=

# ------------------------------------------------------------------- Covers
# Every cover is a folder COVERS_ROOT/<slug>/ with config.yaml (token, texts, buttons,
# statuses) and banners/*.png. Covers are created and edited on the site (Обложки).
COVERS_ROOT=./covers
# Runtime files: product photos (DATA_DIR/products), support attachments and broadcast
# images (DATA_DIR/attachments). Mounted into both containers.
DATA_DIR=./data
# How often (seconds) the bot process re-reads covers (new/disabled covers, changed tokens).
COVERS_RELOAD_SEC=10
# Cover whose bot downloads legacy product photos stored as Telegram file_ids.
SUPPORT_COVER_SLUG=default
# Used ONLY on the very first start to create covers/default/config.yaml; afterwards
# every cover, including "default", takes its token from its own config.yaml.
TYBEE_BOT_TOKEN=
# Legacy: kept in the config and users.is_admin, no longer used by the bots
# (administration lives on the site since ТЗ-2).
TYBEE_ADMIN_IDS=

# Unban fine in rubles for covers whose config.yaml has unban_fine_rub: shared.
UNBAN_FINE_RUB=50
# Maximum number of orders shown in the client profile, newest first.
PROFILE_ORDERS_LIMIT=10

# Automatic support shift end thresholds, in minutes (positive whole numbers).
SUPPORT_SHIFT_OFFLINE_MINUTES=3
SUPPORT_SHIFT_IDLE_MINUTES=15
SUPPORT_SHIFT_NO_REPLY_MINUTES=10

# ---------------------------------------------------------------- Robokassa
# Invoices for orders and unban fines. ResultURL: https://<host>/robokassa/result (bot process).
ROBOKASSA_SHOP_ID=
ROBOKASSA_PASSWORD1=
ROBOKASSA_PASSWORD2=
ROBOKASSA_HASH_ALGORITHM=MD5
ROBOKASSA_TEST=true

# -------------------------------------------------------------------- Avito
# Avito profiles are connected on the site (Avito page, admin only). Their client
# secrets are stored encrypted with this Fernet key; BOTH processes need the same key.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Without it profiles cannot be created or used.
AVITO_SECRET_KEY=
# Public base URL of the bot process webhook server; the site subscribes each profile to
# AVITO_WEBHOOK_URL/avito/webhook/<random secret>.
AVITO_WEBHOOK_URL=
# Port of the bot-process HTTP server (Avito webhooks + Robokassa ResultURL).
AVITO_WEBHOOK_PORT=8080
# Legacy single-account settings: read ONCE on start to create the Avito profile "default"
# (while there are no profiles yet). AVITO_WEBHOOK_SECRET keeps the old subscription URL working.
AVITO_ENABLED=false
AVITO_CLIENT_ID=
AVITO_CLIENT_SECRET=
AVITO_WEBHOOK_SECRET=

# ---------------------------------------------------------------- Web panel
# http://127.0.0.1:WEB_PORT (docker-compose binds to localhost; put a TLS proxy in front).
WEB_PORT=8000
# Telegram ids of administrators (comma-separated); created/kept as Staff(role=admin) on start.
WEB_ADMIN_IDS=
# Separate bot used for sign-in, invites, staff notifications and broadcast test messages.
# For the Login Widget run /setdomain in @BotFather.
WEB_LOGIN_BOT_TOKEN=
# Optional: @username of the login bot (otherwise asked from Telegram via getMe).
WEB_LOGIN_BOT_USERNAME=
# Secret for session cookies (random, long). Without it sessions reset on every restart.
WEB_SESSION_SECRET=
# Public address of the site: notifications about new support threads get an "Открыть" button,
# and the login bot sends a one-time "Открыть панель" sign-in button (after an invite or on /start).
WEB_PUBLIC_URL=
# Local testing only: allows signing in as any active staff member without Telegram.
# Never enable on a publicly accessible environment.
DEV=false
# true when the site is served over HTTPS (secure cookies).
WEB_COOKIE_SECURE=false
